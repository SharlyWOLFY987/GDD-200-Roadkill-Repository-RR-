  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CameraRecognizeObjects
  photoCameraArt: {fileID: 1504936881}
  defaultCameraArt: {fileID: 2009289060}
  tldr: "This script gets the name of the object you are looking at, and when you
    press left click it will add the photo of the object into the photo gallery.
    After the photo is taken, it disables the evidence object after a few seconds
    (collection time variable below).\n\nIn order for this script to work, make sure
    that each piece of evidence is on the EvidenceObjects layer. \n\nAdditionally,
    the game object and name of photo must match exactly. Please name them 'Entity_Evidence'
    like 'DeerMan_BloodyAntler'."
  evidenceLayer:
    serializedVersion: 2
    m_Bits: 64
  maxDistance: 10000
  gameManager: {fileID: 959121465}
  photoGalleryList: []
  collectionTime: 0.5
