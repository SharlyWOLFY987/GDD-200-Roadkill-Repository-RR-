  m_Script: {fileID: 11500000, guid: 65880aa6e6da2a84aa37bfd0d0f3fc59, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PhotoStorage
  tldr: 'This script stores all of the photos in the Evidence folder. It doesn''t
    do anything else, it just stores them for other scripts. Unfortunately you do
    have to add them manually (hit the plus below and drag/drop the photo into an
    empty Element. The order doesn''t matter!)

    Keep this on the GameManager!'
  evidenceImages:
  - {fileID: 2800000, guid: ba23f3bc8527afc4a80385ccf1d8fc75, type: 3}
  - {fileID: 2800000, guid: 78d6f0dddae07c34085304fd5f464bfb, type: 3}
