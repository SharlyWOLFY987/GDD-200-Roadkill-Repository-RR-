  m_Script: {fileID: 11500000, guid: e7e112751172dee4783dbb14728263e3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ScreenShake
  tldr: 'This script shakes the camera. The shake duration controls how long the
    shake lasts.

    The curve below adjusts the strength of the shake, as well
    as the tendency (the straight line keeps the shake steady, while the curves adjust
    the shake strength dynamically).

    This script does need to be on the main
    camera. '
  shakeDuration: 0.1
  curve:
    serializedVersion: 2
    m_Curve:
    - serializedVersion: 3
      time: -0.19510338
      value: 0.0058752354
      inSlope: 0.000086972235
      outSlope: 0.000086972235
      tangentMode: 0
      weightedMode: 0
      inWeight: 0
      outWeight: 1
    - serializedVersion: 3
      time: 0.8048966
      value: 0.0058752354
      inSlope: 0
      outSlope: 0
      tangentMode: 34
      weightedMode: 0
      inWeight: 0.33333334
      outWeight: 0
    m_PreInfinity: 2
    m_PostInfinity: 2
    m_RotationOrder: 4
  start: 0
